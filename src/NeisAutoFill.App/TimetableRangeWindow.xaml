<Window x:Class="NeisAutoFill.App.TimetableRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="입력할 기간" Height="400" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
        <DockPanel>
            <!-- 제목 -->
            <Border DockPanel.Dock="Top" Height="36" Background="White" BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <TextBlock Text="입력할 기간" VerticalAlignment="Center" Margin="14,0"
                           FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
            </Border>

            <!-- 하단 -->
            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F8FAFC"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="취소"
                            Click="Cancel_Click" Padding="16,6" IsCancel="True"/>
                    <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="계속" Click="Ok_Click" Padding="16,6" Margin="0,0,6,0"/>
                    <TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{StaticResource Sub}"/>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Sub}"
                           Text="한 번에 연간 전체를 넣을 필요는 없습니다. 원하는 기간만 골라 나눠서 진행할 수 있어요."/>

                <TextBlock x:Name="SourceRangeText" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Sub}"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="시작일" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0"/>
                    <DatePicker Grid.Column="1" x:Name="FromPicker" SelectedDateChanged="Range_Changed" FontSize="12.5"/>
                    <TextBlock Grid.Column="2" Text="종료일" VerticalAlignment="Center" FontSize="12.5" Margin="14,0,8,0"/>
                    <DatePicker Grid.Column="3" x:Name="ToPicker" SelectedDateChanged="Range_Changed" FontSize="12.5"/>
                </Grid>

                <Button Content="문서 전체 기간으로" Click="Whole_Click" HorizontalAlignment="Left"
                        Margin="0,10,0,0" Padding="10,4" FontSize="11.5" Style="{StaticResource GhostButton}"/>

                <Border Margin="0,18,0,0" Padding="12,10" Background="#F1F5F9"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="OverwriteCheck" IsChecked="True" FontSize="12.5"
                                  Content="이미 값이 있는 칸도 계획대로 덮어쓰기"/>
                        <TextBlock Margin="24,6,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Sub}"
                                   Text="나이스 학급시간표는 기준시간표에서 자동으로 채워져 있는 경우가 많습니다. 끄면 빈 칸만 넣고, 값이 있는 칸에서는 멈춥니다."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
