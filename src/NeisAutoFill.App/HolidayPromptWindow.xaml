<Window x:Class="NeisAutoFill.App.HolidayPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="쉬는 날" SizeToContent="Height" MinHeight="250" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="36" Background="White" BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <TextBlock Text="쉬는 날로 표시" VerticalAlignment="Center" Margin="14,0"
                           FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F8FAFC"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="취소"
                            Click="Cancel_Click" Padding="16,6" IsCancel="True"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="쉬는 날로"
                            Click="Ok_Click" Padding="16,6" Margin="0,0,6,0" IsDefault="True"/>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock x:Name="DateText" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Sub}"
                           Text="이 날의 수업을 모두 빼고 쉬는 날로 표시합니다. 나이스에는 아무것도 넣지 않습니다."/>

                <TextBlock Text="무슨 날인가요?" Margin="0,14,0,4" FontSize="12" Foreground="{StaticResource Sub}"/>
                <TextBox x:Name="NameBox" FontSize="13" Padding="8,6"
                         BorderBrush="{StaticResource Line}" BorderThickness="1"/>

                <ItemsControl Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <Button Style="{StaticResource GhostButton}" Content="재량휴업일" Click="Preset_Click" Padding="9,3" Margin="0,0,4,4" FontSize="11.5"/>
                    <Button Style="{StaticResource GhostButton}" Content="학교 행사" Click="Preset_Click" Padding="9,3" Margin="0,0,4,4" FontSize="11.5"/>
                    <Button Style="{StaticResource GhostButton}" Content="임시휴업" Click="Preset_Click" Padding="9,3" Margin="0,0,4,4" FontSize="11.5"/>
                    <Button Style="{StaticResource GhostButton}" Content="공휴일" Click="Preset_Click" Padding="9,3" Margin="0,0,4,4" FontSize="11.5"/>
                </ItemsControl>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
