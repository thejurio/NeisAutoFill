<Window x:Class="NeisAutoFill.App.TimetableMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="시간표 과목·교사 연결" Height="640" Width="900" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
        <DockPanel>
            <!-- 제목 -->
            <Border DockPanel.Dock="Top" Height="36" Background="White" BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <TextBlock Text="시간표 과목·교사 연결" VerticalAlignment="Center" Margin="14,0"
                           FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
            </Border>

            <!-- 하단 -->
            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F8FAFC"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="취소"
                            Click="Cancel_Click" Padding="16,6"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="적용"
                            Click="Ok_Click" Padding="16,6" Margin="0,0,6,0"
                            IsEnabled="{Binding CanApply}"
                            ToolTip="미해결이 하나라도 있으면 적용할 수 없습니다"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{StaticResource Sub}"/>
                </DockPanel>
            </Border>

            <!-- 카탈로그 변경 경고 -->
            <Border DockPanel.Dock="Top" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="0,0,0,1"
                    Padding="14,7" Visibility="{Binding HasCatalogWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding CatalogChangedWarning}" Foreground="#9A3412" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <TextBlock DockPanel.Dock="Top" Margin="14,10,14,6" FontSize="11.5"
                       Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                       Text="원본 시간표의 표기를 나이스의 과목·교사와 연결합니다. 같은 과목에 교사가 여러 명이면 직접 골라 주세요 — 프로그램이 임의로 정하지 않습니다."/>

            <!-- 예외 규칙 목록 (있을 때만) -->
            <Border DockPanel.Dock="Bottom" Margin="14,0,14,8" Padding="8" Background="#F1F5F9"
                    CornerRadius="4" Visibility="{Binding ExtraRules.Count, Converter={StaticResource GreaterThanZero}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="요일·교시 예외 규칙 (더 구체적인 규칙이 기본값을 덮습니다)"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sub}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding ExtraRules}" MaxHeight="110">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" FontSize="10"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.RemoveExtraRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="이 규칙 삭제"/>
                                    <!-- Run 의 중첩 경로 바인딩은 인라인에서 불안정하다 — TextBlock 을 나란히 둔다 -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SourceToken}" FontSize="11.5" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text=" → " FontSize="11.5" Foreground="{StaticResource Sub}"/>
                                        <TextBlock Text="{Binding Scope.Description}" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 표기별 매핑 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,0,14,4">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 왼쪽: 원본 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource Ink}">
                                            <Run Text="{Binding Token, Mode=OneWay}"/>
                                            <Run Text="{Binding Standard, Mode=OneWay, StringFormat=' ({0})'}"
                                                 FontSize="11.5" FontWeight="Normal" Foreground="{StaticResource Sub}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                                                   Text="{Binding UsedWhere}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource Sub}"
                                                   Text="{Binding UseCount, StringFormat='{}{0}칸에 사용'}"/>
                                    </StackPanel>

                                    <!-- 가운데: 후보 선택 -->
                                    <StackPanel Grid.Column="1">
                                        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected}"
                                                  DisplayMemberPath="Display" FontSize="12.5" Padding="6,4"
                                                  IsEnabled="{Binding Skip, Converter={StaticResource InvertBool}}"/>
                                        <TextBlock FontSize="11" Margin="2,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Sub}" Text="{Binding Hint}"/>
                                    </StackPanel>

                                    <!-- 오른쪽: 상태·범위 -->
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" MinWidth="150">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource Neis}"/>
                                        <CheckBox Content="입력 안 함" IsChecked="{Binding Skip}" FontSize="11"
                                                  HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="요일별" FontSize="10.5" Padding="7,2" Margin="0,0,4,0"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.AddDayRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="지금 고른 교사를 이 표기가 쓰인 요일별 규칙으로 만듭니다"/>
                                            <Button Content="요일·교시별" FontSize="10.5" Padding="7,2"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.AddDayPeriodRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="요일과 교시까지 지정한 규칙으로 만듭니다"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
