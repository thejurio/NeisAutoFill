<Window x:Class="NeisAutoFill.App.EvalPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="평가계획 나이스 입력" Height="620" Width="880" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="{StaticResource Panel2}">
        <DockPanel>

            <!-- 제목줄 -->
            <Border DockPanel.Dock="Top" Height="38" Background="White"
                    BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕"
                            Click="Close_Click" Padding="12,4" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="평가계획 나이스 입력" VerticalAlignment="Center" Margin="14,0"
                               FontWeight="Bold" FontSize="13" Foreground="{StaticResource Ink}"/>
                </DockPanel>
            </Border>

            <!-- 아래 실행줄 -->
            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="White"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <!-- 못 누르는 이유를 단추 옆에 그대로 적는다 — 꺼진 단추만 두지 않는다 -->
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="540">
                        <TextBlock FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                                   Text="{Binding DocumentSummary}"/>
                        <TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="#8F550F" Text="{Binding Blocker}"
                                   Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="입력 시작" Command="{Binding RunCommand}" Padding="18,7"
                            Visibility="{Binding IsRunning, Converter={StaticResource TrueToCollapsed}}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                            Content="작업 중지" Command="{Binding StopCommand}" Padding="18,7"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                </DockPanel>
            </Border>

            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ① 문서 -->
                <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="14,12"
                        BorderThickness="1" BorderBrush="{StaticResource Line}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                Content="문서 고르기" Command="{Binding PickDocumentCommand}" Padding="14,6"/>
                        <StackPanel>
                            <TextBlock Text="① 평가계획 문서" FontWeight="Bold" FontSize="12.5"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Sub}"
                                       Text="학교에서 받은 평가계획 (PDF · HWP · HWPX)&#10;[자료 준비]에서 이미 읽으셨다면 그 문서를 그대로 씁니다."
                                       Visibility="{Binding HasDocument, Converter={StaticResource TrueToCollapsed}}"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Neis}"
                                       FontWeight="SemiBold" Text="{Binding DocumentName}"
                                       Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 뺀 영역 안내 -->
                <Border Grid.Row="1" Margin="0,8,0,0" Background="#FBF2E3" CornerRadius="6"
                        Padding="12,9" BorderThickness="1" BorderBrush="#E7CDA2"
                        Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SkippedNote}" TextWrapping="Wrap"
                               FontSize="12" Foreground="#8F550F" LineHeight="18"/>
                </Border>

                <!-- ② 교과 고르기 -->
                <Border Grid.Row="2" Margin="0,10,0,0" Background="White" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{StaticResource Line}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource Line}">
                            <TextBlock FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"
                                       Text="② 넣을 교과 고르기"/>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Margin="14,20" FontSize="12.5"
                                   Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                                   Text="문서를 먼저 골라 주세요. 어떤 교과가 들어가는지 여기에 나옵니다."
                                   Visibility="{Binding HasDocument, Converter={StaticResource TrueToCollapsed}}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Subjects}" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" Padding="10,8" CornerRadius="5"
                                                BorderThickness="1" BorderBrush="{StaticResource Line}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected}"
                                                          VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}"
                                                                   FontSize="11.5" Foreground="{StaticResource Sub}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Subject}" FontWeight="Bold"
                                                                   FontSize="13" Foreground="{StaticResource Ink}"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Areas}" FontSize="11.5" Margin="0,3,0,0"
                                                               Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Result}" FontSize="11.5" Margin="0,5,0,0"
                                                               TextWrapping="Wrap" Foreground="{StaticResource Neis}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Result}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                        <Setter Property="Foreground" Value="#8F550F"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
