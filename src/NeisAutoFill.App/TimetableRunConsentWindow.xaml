<Window x:Class="NeisAutoFill.App.TimetableRunConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="나이스에 입력·저장" Height="440" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
        <DockPanel>
            <!-- 제목 -->
            <Border DockPanel.Dock="Top" Height="36" Background="White" BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <TextBlock Text="나이스에 실제로 입력하고 저장합니다" VerticalAlignment="Center" Margin="14,0"
                           FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
            </Border>

            <!-- 하단 -->
            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F8FAFC"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="취소"
                            Click="Cancel_Click" Padding="16,6" IsCancel="True"/>
                    <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="입력 시작" Click="Ok_Click" Padding="16,6" Margin="0,0,6,0"
                            IsEnabled="False"
                            ToolTip="아래 동의에 체크해야 시작할 수 있습니다"/>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock Text="지금부터 하는 일" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="SummaryText" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource Ink}" LineHeight="20"/>

                <Border Margin="0,14,0,0" Padding="12,10" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="확인해 주세요" FontWeight="Bold" FontSize="12" Foreground="#9A3412"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#9A3412" LineHeight="19"
                                   Text="· 여기서 저장하면 나이스에 그대로 남습니다. 프로그램은 되돌리지 못합니다.&#10;· 되돌리려면 나이스에서 해당 칸을 우클릭해 [수업삭제] 후 저장하세요.&#10;· 진행하는 동안 브라우저를 직접 조작하지 마세요.&#10;· 한 주라도 문제가 생기면 거기서 멈추고, 끝난 주까지는 기록해 둡니다."/>
                    </StackPanel>
                </Border>

                <Border x:Name="ResumeBox" Margin="0,10,0,0" Padding="12,10" Background="#F1F5F9"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Visibility="Collapsed">
                    <TextBlock x:Name="ResumeText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Sub}"/>
                </Border>

                <CheckBox x:Name="ConsentCheck" Margin="0,16,0,0" FontSize="12.5"
                          Content="나이스에 실제로 입력하고 저장하는 것에 동의합니다."
                          Checked="Consent_Changed" Unchecked="Consent_Changed"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
