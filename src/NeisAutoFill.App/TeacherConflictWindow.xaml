<Window x:Class="NeisAutoFill.App.TeacherConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="예외가 있는 과목" SizeToContent="Height" MinHeight="290" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="36" Background="White" BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="14,0"
                           FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F8FAFC"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="취소"
                            Click="Cancel_Click" Padding="14,6" IsCancel="True"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" x:Name="KeepButton"
                            Click="Keep_Click" Padding="14,6" Margin="0,0,6,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" x:Name="ReplaceButton"
                            Click="Replace_Click" Padding="14,6" Margin="0,0,6,0" IsDefault="True"/>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14">
                <TextBlock x:Name="HeadText" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource Sub}" LineHeight="21"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
