<Window x:Class="NeisAutoFill.App.TimetableResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="시간표 입력 결과" Height="560" Width="820" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
        <DockPanel>
            <!-- 제목 -->
            <Border DockPanel.Dock="Top" Height="36" Background="White" BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <TextBlock Text="시간표 입력 결과" VerticalAlignment="Center" Margin="14,0"
                           FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
            </Border>

            <!-- 하단 -->
            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F8FAFC"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="닫기"
                            Click="Close_Click" Padding="16,6" IsCancel="True"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="이어서 다시 시도"
                            Click="Retry_Click" Padding="16,6" Margin="0,0,6,0"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Checkpoint}" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{StaticResource Sub}"/>
                </DockPanel>
            </Border>

            <!-- 요약 -->
            <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                <TextBlock Text="{Binding Headline}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="{Binding Detail}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource Sub}"/>
            </StackPanel>

            <!-- 다시 시도 안내 -->
            <Border DockPanel.Dock="Bottom" Margin="14,0,14,10" Padding="10,8" Background="#F1F5F9"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Visibility="{Binding HasRetryHint, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding RetryHint}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Sub}"/>
            </Border>

            <DataGrid ItemsSource="{Binding Rows}" Margin="14,0,14,10" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Line}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" Background="White" RowBackground="White"
                      AlternatingRowBackground="#FAFAFA" FontSize="12" CanUserSortColumns="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="주" Binding="{Binding Week}" Width="90"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="입력" Binding="{Binding Written}" Width="60"/>
                    <DataGridTextColumn Header="건너뜀" Binding="{Binding Skipped}" Width="70"/>
                    <DataGridTextColumn Header="설명" Binding="{Binding Detail}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Margin" Value="4,3"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
