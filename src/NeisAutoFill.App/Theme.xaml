<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:NeisAutoFill.App">

    <!-- 등급 배지 색 컨버터 -->
    <app:GradeBadgeConverter x:Key="BadgeBg" Target="Background"/>
    <app:GradeBadgeConverter x:Key="BadgeFg" Target="Foreground"/>

    <!-- 표시 여부 컨버터 -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <app:StringToVisibilityConverter x:Key="StringToVis"/>
    <app:GreaterThanZeroConverter x:Key="GreaterThanZero"/>
    <app:InvertBoolConverter x:Key="InvertBool"/>
    <app:TrueToCollapsedConverter x:Key="TrueToCollapsed"/>
    <app:ZeroToVisibleConverter x:Key="ZeroToVis"/>
    <app:EmptyToDashConverter x:Key="EmptyDash"/>

    <!-- ==== NEIS 팔레트 (실측 #3175FF) ==== -->
    <Color x:Key="NeisColor">#3175FF</Color>
    <SolidColorBrush x:Key="Neis" Color="#3175FF"/>
    <SolidColorBrush x:Key="NeisDark" Color="#1F5BE0"/>
    <SolidColorBrush x:Key="NeisSoft" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="Ink" Color="#1E293B"/>
    <SolidColorBrush x:Key="Sub" Color="#64748B"/>
    <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Panel" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Panel2" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>

    <FontFamily x:Key="UiFont">Malgun Gothic</FontFamily>

    <!-- 전역 기본 폰트 -->
    <Style TargetType="Control" x:Key="BaseControl">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>

    <!-- ==== 주요 버튼 (파랑) ==== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Neis}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource NeisDark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== 보조 버튼 (아웃라인) ==== -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#cbd5e1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 강조 아웃라인(파란 글자) -->
    <Style x:Key="AccentGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource Neis}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 위험 아웃라인(빨간 글자) — 삭제·초기화용 -->
    <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="#B91C1C"/>
    </Style>


    <!-- 스플릿 버튼 (좌: 본체 / 우: ▾ 드롭다운) — 붙여서 하나처럼 보이게 -->
    <Style x:Key="GhostButtonLeft" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7,0,0,7"
                            BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GhostButtonRight" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="7,7"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="0,7,7,0"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 아웃라인 토글 (켜지면 파란 톤) -->
    <Style x:Key="GhostToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#cbd5e1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource NeisSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Neis}"/>
                            <Setter Property="Foreground" Value="{StaticResource Neis}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 타이틀바 창 제어 버튼 -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==== 콤보박스 (심플) ==== -->
    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ==== 성적표 편집용 콤보 (둥근 모서리, 얇은 라인) ==== -->
    <Style x:Key="GradeEditCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Margin" Value="4,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bd" Background="White" CornerRadius="6"
                                BorderBrush="{StaticResource Neis}" BorderThickness="1.4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="9,0,0,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"/>
                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource Sub}"/>
                            </Grid>
                        </Border>
                        <ToggleButton Opacity="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#0F172A"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" Margin="4"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeisDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="9,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ib" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ib" Property="Background" Value="{StaticResource NeisSoft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== 탭 (밑줄형) ==== -->
    <Style x:Key="UnderlineTab" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="b" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="16,9">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Neis}"/>
                            <Setter Property="Foreground" Value="{StaticResource Neis}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== 표 안의 숫자 칸 — 오른쪽 정렬 ==== -->
    <Style x:Key="NumberCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ==== 앱 상위 탭 (평가 / 시간표) ====
         밑줄만으로는 "누르는 것"으로 보이지 않아서, 서로 붙은 알약형 버튼으로 만든다.
         고르지 않은 탭도 테두리와 배경이 있어 클릭 대상임이 드러난다. -->
    <!--
        큰 축 탭 (평가 / 시간표) — <b>한 홈 안에 붙인 전환 컨트롤</b>.

        전에는 둘이 따로 떨어진 알약이라 <b>그냥 단추 두 개로 읽혔다.</b> 이제 홈(track) 안에
        나란히 넣어 "이 중 <b>하나</b>를 고르는 것"임을 모양으로 보인다 (D-DeskCal 의 월간·주간·안건과 같은 꼴).

        덤으로 <b>오른쪽이 잘리던 문제가 구조적으로 사라진다.</b> 칸마다 최소 폭을 주고 글을 가운데 두므로,
        헤더를 잰 너비보다 조금 넓게 그려도 남는 자리가 흡수한다 —
        예전에는 폭이 글자에 딱 맞아서 넘치는 만큼 오른쪽이 눌렸다(실측: 왼쪽 21px · 오른쪽 9px).
    -->
    <Style x:Key="MainTabControl" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <!-- 홈. 흰 바탕 위에서도 보이도록 Panel 보다 한 단계 진한 Line 을 쓴다 -->
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="14,10,14,8"
                                CornerRadius="9" Padding="3" Background="{StaticResource Line}">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 홈 안의 칸 하나. 고른 것만 도드라진다. -->
    <Style x:Key="MainTab" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="108"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6"
                            Padding="14,0" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Neis}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="b" Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="{StaticResource Neis}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==== 진행 막대의 단계 칩 ====
         끝난 단계는 ✓ 로, 남은 단계는 번호로. 누르면 그 단계를 다시 한다. -->
    <Style x:Key="StepChip" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="White" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="16" Padding="10,5">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource NeisSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Neis}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 누를 수 없는 단계 칩 (상태만 보여 준다) -->
    <Style x:Key="StepChipFlat" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- 칩 앞의 번호 / ✓ -->
    <Style x:Key="StepMark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Neis}"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==== 단계 카드 ====
         지금 차례인 단계만 파란 테두리로 감싼다. 번호만으로는 어디부터 손대야 할지 안 보인다.
         끝난 단계는 흐리게 두어 눈이 자연히 다음으로 넘어가게 한다. -->
    <Style x:Key="StepCard" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- ==== 단계 한 덩어리 — 사이를 띄워 눈이 순서를 따라가게 한다 ==== -->
    <Style x:Key="StepBlock" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>

    <!-- ==== 시간표 탭의 단계 제목 ==== -->
    <Style x:Key="StepTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Neis}"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <!-- 단계 아래 작은 설명·상태 줄 -->
    <Style x:Key="StepNote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Sub}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
    </Style>

    <!-- ==== 시간표 격자의 칸 ==== -->
    <Style x:Key="TimetableCellButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                            Padding="4,3">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== DataGrid ==== -->
    <Style x:Key="CleanGrid" TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7"/>
        <Setter Property="VerticalGridLinesBrush" Value="#F6F8FB"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="CleanGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

</ResourceDictionary>
