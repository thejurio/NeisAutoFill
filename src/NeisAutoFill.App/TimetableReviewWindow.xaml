<Window x:Class="NeisAutoFill.App.TimetableReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="시간표 인식 결과 확인" Height="680" Width="980" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 칸 하나: 원본 표기를 그대로 고칠 수 있다 -->
        <DataTemplate x:Key="CellTemplate">
            <Border Margin="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3"
                    ToolTip="{Binding Tooltip}">
                <Grid>
                    <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" TextAlignment="Center"
                             FontSize="13" Padding="0,5" MaxLength="6"
                             IsEnabled="{Binding IsPlaceholder, Converter={StaticResource InvertBool}}"/>
                    <!-- 확인이 필요한 칸(창체 미해결 등)은 오른쪽 위에 점 -->
                    <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,3,3,0"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="36" Background="White"
                    BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <TextBlock Text="시간표 인식 결과 확인" VerticalAlignment="Center" Margin="14,0"
                           FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"/>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F8FAFC"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="취소"
                            Click="Cancel_Click" Padding="16,6"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="이대로 사용"
                            Click="Ok_Click" Padding="16,6" Margin="0,0,6,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Header}" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{StaticResource Sub}"/>
                </DockPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" Margin="14,10,14,8" FontSize="11.5"
                       Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                       Text="문서에서 읽은 시간표입니다. 잘못 읽힌 칸은 직접 고치세요 — 칸을 비우면 그 시간은 입력하지 않습니다. 주황 점은 확인이 필요한 칸입니다."/>

            <!-- 문제 목록 -->
            <Border DockPanel.Dock="Top" Margin="14,0,14,8" Padding="10,8" Background="#FFF7ED"
                    BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentGhostButton}"
                            Content="확인할 주로" Padding="10,3" VerticalAlignment="Top"
                            Command="{Binding JumpToProblemCommand}"/>
                    <ItemsControl ItemsSource="{Binding Problems}" MaxHeight="88">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#9A3412"
                                           TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 주차 목록 -->
                <ListBox Grid.Column="0" ItemsSource="{Binding Weeks}" SelectedItem="{Binding Selected}"
                         BorderBrush="{StaticResource Line}" BorderThickness="1" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Summary}" FontSize="10.5" Foreground="{StaticResource Sub}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 선택한 주의 표 -->
                <DockPanel Grid.Column="1" Margin="10,0,0,0" DataContext="{Binding Selected}">
                    <UniformGrid DockPanel.Dock="Top" Columns="6" Margin="0,0,0,3">
                        <TextBlock Text="교시" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding Mon}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding Tue}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding Wed}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding Thu}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Sub}"/>
                        <TextBlock Text="{Binding Fri}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource Sub}"/>
                    </UniformGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <UniformGrid Columns="6">
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" TextAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Sub}"/>
                                        <ContentControl Content="{Binding Mon}" ContentTemplate="{StaticResource CellTemplate}"/>
                                        <ContentControl Content="{Binding Tue}" ContentTemplate="{StaticResource CellTemplate}"/>
                                        <ContentControl Content="{Binding Wed}" ContentTemplate="{StaticResource CellTemplate}"/>
                                        <ContentControl Content="{Binding Thu}" ContentTemplate="{StaticResource CellTemplate}"/>
                                        <ContentControl Content="{Binding Fri}" ContentTemplate="{StaticResource CellTemplate}"/>
                                    </UniformGrid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
