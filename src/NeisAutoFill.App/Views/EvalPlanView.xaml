<UserControl x:Class="NeisAutoFill.App.Views.EvalPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
             FontFamily="{StaticResource UiFont}">
    <!--
        평가계획을 나이스 [평가계획(안)관리]에 넣는 화면. 따로 뜨던 창에서 [평가] 탭 안으로 옮겼다
        (사용자 요청 2026-08-22). 자료는 [자료 준비]에 있는 것을 그대로 쓴다.
    -->
    <DockPanel Background="{StaticResource Panel2}">
            <!-- 아래 실행줄 -->
            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="White"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <!-- 못 누르는 이유를 단추 옆에 그대로 적는다 — 꺼진 단추만 두지 않는다 -->
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="560">
                        <TextBlock FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                                   Text="{Binding Summary}"/>
                        <TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="#8F550F" Text="{Binding Blocker}"
                                   Visibility="{Binding HasBlocker, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="입력 시작" Command="{Binding RunCommand}" Padding="18,7"
                            Visibility="{Binding IsRunning, Converter={StaticResource TrueToCollapsed}}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                            Content="작업 중지" Command="{Binding StopCommand}" Padding="18,7"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                </DockPanel>
            </Border>

            <!-- 본문: 교과 고르기 -->
            <Border Margin="14" Background="White" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{StaticResource Line}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource Line}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButtonLeft}" Content="모두"
                                        Command="{Binding SelectAllCommand}" CommandParameter="all" Padding="10,4"/>
                                <Button Style="{StaticResource GhostButtonRight}" Content="해제"
                                        Command="{Binding SelectAllCommand}" CommandParameter="none" Padding="10,4"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Ink}"
                                           Text="넣을 교과 고르기"/>
                                <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{StaticResource Sub}"
                                           Text="[자료 준비]의 평가계획을 그대로 넣습니다. 교과를 누르면 내용을 볼 수 있습니다."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Margin="14,24" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource Sub}"
                               Text="[자료 준비]에 평가계획이 없습니다. 거기서 평가계획을 넣거나 문서를 불러온 뒤 다시 열어 주세요."
                               Visibility="{Binding HasPlans, Converter={StaticResource TrueToCollapsed}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                                  Visibility="{Binding HasPlans, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Subjects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 세 단 — 교과가 열 개가 넘어 한 줄에 하나씩이면 너무 길다 -->
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Padding="10,9" CornerRadius="5" Background="White"
                                            BorderThickness="1" BorderBrush="{StaticResource Line}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected}"
                                                      VerticalAlignment="Top" Margin="0,2,9,0"/>
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                                            Content="내용 보기" Click="Detail_Click" Tag="{Binding}"
                                                            VerticalAlignment="Center" Padding="7,2" FontSize="11"
                                                            ToolTip="이 교과의 영역·성취기준·평가단계를 봅니다"/>
                                                    <TextBlock Text="{Binding Subject}" FontWeight="Bold"
                                                               FontSize="13" Foreground="{StaticResource Ink}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{StaticResource Sub}"/>
                                                <TextBlock Text="{Binding Areas}" FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                                                           MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Result}" FontSize="11" Margin="0,5,0,0"
                                                           TextWrapping="Wrap" Foreground="{StaticResource Neis}"
                                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                    <Setter Property="Foreground" Value="#8F550F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
