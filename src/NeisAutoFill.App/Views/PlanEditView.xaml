<UserControl x:Class="NeisAutoFill.App.Views.PlanEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
             FontFamily="{StaticResource UiFont}">
    <!--
        과목별 평가계획 편집표. 전에는 [자료 준비] 창의 오른쪽 절반이었는데
        [평가] 탭 안 [평가계획] 갈래로 옮겼다 (사용자 요청 2026-08-22).

        <b>학생 명단은 여기 없다.</b> 명단은 [교과평가] 표에서 바로 고치는 것이 원본이 되었다 —
        같은 것을 두 곳에서 고치면 어느 쪽이 맞는지 알 수 없다.
    -->
    <Grid Background="White" Margin="14,12,14,12">
                <!-- ===== 우: 과목별 평가계획 ===== -->
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="＋ 과목" Command="{Binding AddSubjectCommand}" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource DangerGhostButton}" Content="🗑 삭제" Click="PlanDeleteMenu_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="이 과목 삭제" Command="{Binding RemoveSubjectCommand}"/>
                                        <MenuItem Header="전체 평가계획 비우기" Click="ClearAllPlans_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- 전담: 학년 선택 (반과 함께 자동 추가됨. 학년 바꾸면 그 학년 계획 로드/저장. 여러 반이 공유) -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSubjectMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="학년" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Neis}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding GradeOptions}" SelectedItem="{Binding SelectedGrade}" MinWidth="70" Margin="0,0,10,0"
                                          ToolTip="학년은 왼쪽 명단에서 반을 추가하면 자동으로 생깁니다"/>
                            </StackPanel>
                            <TextBlock Text="과목" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"
                                      DisplayMemberPath="Name" Width="100" Margin="0,0,10,0"/>
                            <TextBlock Text="과목명" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding SelectedSubject.Name, UpdateSourceTrigger=PropertyChanged}" Width="100" MinWidth="90" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="한 행 = 평가 하나. 같은 영역이 여러 행이어도 됩니다. 마지막 빈 행에 입력하면 평가가 추가됩니다. 엑셀 표를 복사해 셀에서 Ctrl+V로 붙여넣을 수 있습니다. 등급 열:"/>
                        <Run Text="{Binding ScaleSummary, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ImportStatus}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Neis}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ImportStatus, Converter={StaticResource StringToVis}}"/>
                    <!-- 인식 검수 경고 — 오인식·누락 의심 지점을 표에서 확인하도록 안내 -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="8"
                            Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="🔎 인식 검수 — 아래 항목을 표에서 확인하세요"
                                       FontWeight="SemiBold" FontSize="11.5" Foreground="#9A3412" Margin="0,0,0,4"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecognitionWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="＋ 영역 행" Click="AddPlanRow_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="－ 선택 행 삭제" Click="RemovePlanRow_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="PlanGrid" ItemsSource="{Binding SelectedSubject.GridView}"
                              Style="{StaticResource CleanGrid}" ColumnHeaderStyle="{StaticResource CleanGridHeader}"
                              AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False"
                              SelectionUnit="CellOrRowHeader" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                              BorderBrush="{StaticResource Line}" BorderThickness="1"
                              AutoGeneratingColumn="PlanGrid_AutoGeneratingColumn"
                              PreviewKeyDown="PlanGrid_PreviewKeyDown">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" x:Key="WrapCell">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </DockPanel>

        <!-- AI 분석 중 오버레이 — 화면 전체를 덮어 처리 중임을 직관적으로 표시 -->
        <Border Background="#B3FFFFFF" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
            <Border Background="White" BorderBrush="{StaticResource Neis}" BorderThickness="1.5" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,26" MaxWidth="440">
                <StackPanel>
                    <TextBlock Text="📄" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="평가계획서를 읽고 있어요" FontWeight="Bold" FontSize="14.5"
                               Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ImportStatus}" FontSize="11.5" Foreground="{StaticResource Sub}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,14"/>
                    <ProgressBar IsIndeterminate="True" Height="6" Width="260"
                                 Background="{StaticResource Panel}" Foreground="{StaticResource Neis}" BorderThickness="0"/>
                    <TextBlock Text="아는 양식이면 금방 끝나고, 낯선 양식은 AI 인식으로 수십 초 걸릴 수 있습니다" FontSize="10.5" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
