<Window x:Class="NeisAutoFill.App.EvalDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="평가계획 내용" Height="620" Width="820" MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="{StaticResource Panel2}">
        <DockPanel>

            <Border DockPanel.Dock="Top" Height="38" Background="White"
                    BorderBrush="{StaticResource Neis}" BorderThickness="0,0,0,2">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕"
                            Click="Close_Click" Padding="12,4" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="14,0"
                               FontWeight="Bold" FontSize="13" Foreground="{StaticResource Ink}"/>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="14,9" Background="White"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <TextBlock FontSize="11.5" Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                           Text="[평가계획]에 저장된 내용입니다. 고치려면 [평가계획]에서 수정해 주세요. 수정한 내용이 나이스에 입력됩니다."/>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <ItemsControl x:Name="AreaList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="6" Background="White"
                                    BorderThickness="1" BorderBrush="{StaticResource Line}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Area}" FontWeight="Bold" FontSize="12.5"
                                               Foreground="{StaticResource Neis}"/>
                                    <TextBlock Text="{Binding Standard}" FontSize="12.5" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource Ink}" LineHeight="19"/>

                                    <ItemsControl ItemsSource="{Binding Criteria}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource Panel}"
                                                            CornerRadius="3" Padding="6,2" Margin="0,0,10,0"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Level}" FontSize="11.5"
                                                                   FontWeight="SemiBold" TextAlignment="Center"
                                                                   Foreground="{StaticResource Ink}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="12.5"
                                                               TextWrapping="Wrap" LineHeight="19"
                                                               Foreground="{StaticResource Ink}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
